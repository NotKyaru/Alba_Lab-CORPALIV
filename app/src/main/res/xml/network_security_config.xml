<?xml version="1.0" encoding="utf-8"?>
<!-- Android 9+ bloquea HTTP sin cifrar. Se permite solo hacia el backend local:
     127.0.0.1 del dispositivo llega al PC a través de "adb reverse". -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
