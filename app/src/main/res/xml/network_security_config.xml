<?xml version="1.0" encoding="utf-8"?>
<!-- Android 9+ bloquea HTTP sin cifrar. Se permite solo hacia el backend local:
     10.0.2.2 es el PC visto desde el emulador. Para un teléfono físico,
     agrega aquí la IP del PC en la red Wi-Fi. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
